{
  "name": "@raincode/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-main.mjs && node scripts/build-agent.mjs && vite build",
    "build:main": "node scripts/build-main.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "build:renderer": "vite build",
    "dist": "electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@raincode/rpc": "workspace:*",
    "@raincode/server": "workspace:*",
    "@raincode/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "better-sqlite3": "^12.11.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "zustand": "^4.5.0"
  }
}
