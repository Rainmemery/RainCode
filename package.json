{
  "name": "raincode",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "node --import tsx --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "lint": "oxlint packages apps scripts",
    "protocol:gen": "tsx scripts/gen-protocol-catalog.mts",
    "protocol:check": "tsx scripts/gen-protocol-catalog.mts --check",
    "architecture:check": "node scripts/architecture-check.mjs",
    "bench:start": "tsx scripts/bench.mts start",
    "bench:send": "tsx scripts/bench.mts send",
    "bench:render": "tsx scripts/bench.mts render",
    "bench:resume": "tsx scripts/bench.mts resume",
    "bench:crash": "tsx scripts/bench.mts crash",
    "bench:mem:desktop": "tsx scripts/bench-mem-desktop.mts",
    "bench:all": "tsx scripts/bench.mts all",
    "smoke:e2e": "tsx scripts/smoke-e2e.mts",
    "smoke:tools": "tsx scripts/smoke-tools.mts",
    "smoke:permission": "tsx scripts/smoke-permission.mts",
    "smoke:p0": "tsx scripts/smoke-p0.mts",
    "smoke:compact": "tsx scripts/smoke-compact.mts",
    "smoke:mcp": "tsx scripts/smoke-mcp.mts",
    "smoke:subagent": "tsx scripts/smoke-subagent.mts",
    "smoke:memory": "tsx scripts/smoke-memory.mts",
    "smoke:plugin": "tsx scripts/smoke-plugin.mts",
    "smoke:migrations": "tsx scripts/smoke-migrations.mts",
    "smoke:p1tools": "tsx scripts/smoke-p1tools.mts",
    "smoke:kernel": "tsx scripts/smoke-kernel.mts",
    "smoke:skills": "tsx scripts/smoke-skills.mts",
    "smoke:stdio": "tsx scripts/smoke-stdio.mts",
    "smoke:hooks": "tsx scripts/smoke-hooks.mts",
    "smoke:remote": "tsx scripts/smoke-remote.mts",
    "smoke:ssh": "tsx scripts/smoke-ssh.mts",
    "smoke:web": "tsx scripts/smoke-web.mts",
    "walkthrough:web": "tsx scripts/walkthrough-web.mts",
    "walkthrough:desktop": "tsx scripts/walkthrough-desktop.mts",
    "shots:web": "tsx scripts/product-shots-web.mts",
    "shots:desktop": "tsx scripts/product-shots-desktop.mts"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.85.0",
    "ssh2": "^1.17.0",
    "tsx": "^4.19.2",
    "ws": "^8.22.0"
  }
}
